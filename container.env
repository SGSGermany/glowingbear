REGISTRY="${REGISTRY:-ghcr.io}"
OWNER="${OWNER:-sgsgermany}"
IMAGE="${IMAGE:-glowingbear}"
TAGS="${TAGS:-latest}"

VERSION="${VERSION:-}"

GIT_REPO="https://github.com/torhve/glowing-bear.git"
GIT_REF="refs/heads/main"
[ -z "$VERSION" ] || GIT_REF="refs/tags/v$VERSION"

BASE_IMAGE="ghcr.io/sgsgermany/alpine:v3.24"
